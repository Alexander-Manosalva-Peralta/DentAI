{
  "manifest_version": 3,
  "name": "DentAI – Asistente clínico por voz (Manos Libres)",
  "version": "0.3.7",
  "description": "Asistente clínico por voz 100% manos libres para Smile (Cibermundo). Conectado a SQL Server SMILE QA Cayetano Heredia, consulta DNI RENIEC y cero contaminación cruzada.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Abrir DentAI"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.decolecta.com/*",
    "https://api.apis.net.pe/*",
    "https://apiperu.dev/*",
    "https://api.perudevs.com/*",
    "https://dniruc.apisperu.net/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Abrir / cerrar DentAI"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}